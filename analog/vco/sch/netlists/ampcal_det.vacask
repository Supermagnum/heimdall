P2.7.1 ampcal_det
include "sg13g2_vacask_common.lib"
include "cornerMOSlv.lib" section=mos_tt
include "cornerMOShv.lib" section=mos_tt
include "cornerCAP.lib" section=cap_typ
load "resistor.osdi"
load "capacitor.osdi"
load "inductor.osdi"
model resistor resistor
model capacitor capacitor
model inductor inductor
model vsource vsource
model isource isource

mdtp (vdd tp hold 0) sg13_lv_nmos w=0.5u l=0.13u ng=1
mdtn (vdd tn hold 0) sg13_lv_nmos w=0.5u l=0.13u ng=1
mrtp (vdd ct rep 0) sg13_lv_nmos w=0.5u l=0.13u ng=1
mrtn (vdd ct rep 0) sg13_lv_nmos w=0.5u l=0.13u ng=1
chold (hold 0) cap_cmim w=16.270u l=16.270u
crep (rep 0) cap_cmim w=16.270u l=16.270u
rbias (vdd nbias 0) rhigh w=0.500u l=78.000u b=0
mdiode (nbias nbias pd_d 0) sg13_lv_nmos w=1.0u l=1.0u ng=1
men_d (pd_d en 0 0) sg13_lv_nmos w=2.0u l=0.13u ng=1
mid_h (hold nbias pd_h 0) sg13_lv_nmos w=1.0u l=1.0u ng=1
men_h (pd_h en 0 0) sg13_lv_nmos w=2.0u l=0.13u ng=1
mid_r (rep nbias pd_r 0) sg13_lv_nmos w=1.0u l=1.0u ng=1
men_r (pd_r en 0 0) sg13_lv_nmos w=2.0u l=0.13u ng=1
mid_tt (ttail nbias pd_tt 0) sg13_lv_nmos w=5.5u l=1.0u ng=2
men_tt (pd_tt en 0 0) sg13_lv_nmos w=2.0u l=0.13u ng=1
mid_ss (ss2 nbias pd_ss 0) sg13_lv_nmos w=5.5u l=1.0u ng=2
men_ss (pd_ss en 0 0) sg13_lv_nmos w=2.0u l=0.13u ng=1
mc1 (co hold ttail 0) sg13_lv_nmos w=4u l=0.5u ng=2
mc2 (co2 vthn ttail 0) sg13_lv_nmos w=4u l=0.5u ng=2
rc1 (vdd co 0) rhigh w=0.500u l=6.960u b=0
rc2 (vdd co2 0) rhigh w=0.500u l=6.960u b=0
mcs1 (n1 co2 ss2 0) sg13_lv_nmos w=4u l=0.5u ng=2
mcs2 (cmp co ss2 0) sg13_lv_nmos w=4u l=0.5u ng=2
mpl1 (n1 n1 vdd vdd) sg13_lv_pmos w=4u l=0.5u ng=2
mpl2 (cmp n1 vdd vdd) sg13_lv_pmos w=4u l=0.5u ng=2
cl_cmp (cmp 0) cap_cmim w=5.780u l=5.780u
