P2.7.4b lo_buffer

include "sg13g2_vacask_common.lib"
include "cornerMOSlv.lib" section=mos_tt

load "resistor.osdi"
load "capacitor.osdi"

model resistor  resistor
model capacitor capacitor
model vsource   vsource
model isource   isource

embed "clk.va" <<<FILE
`include "constants.vams"
`include "disciplines.vams"
// Differential clock: sine (shape = 0) or smoothed square (shape > 0, tanh sharpness), common mode vcm.
// Amplitude envelope: 0 before t0, linear ramp over tr, then full (t0 = -1 s: full from the start).
module clk(p, n);
    inout p, n;
    electrical p, n;
    real env, w;
    analog begin
        env = min(max(($abstime - (-1.0)) / 1.0000e-12, 0.0), 1.0);
        w = (0.0 > 0) ? tanh(0.0 * (sin(2 * `M_PI * 3.840000e+09 * $abstime) - 0.0)) : sin(2 * `M_PI * 3.840000e+09 * $abstime);
        V(p) <+ 0.6 + 0.5 * env * w;
        V(n) <+ 0.6 - 0.5 * env * w;
    end
endmodule
>>>FILE
load "clk.va"
model clk clk
ccp (tp x_bip) capacitor c=100f
rfp (x_bip x_bop) resistor r=50k
xb1pp (x_bop x_bip vbuf vbuf) sg13_lv_pmos w=4u l=0.13u
xb1pn (x_bop x_bip 0 0) sg13_lv_nmos w=2u l=0.13u
ccmp (x_bop x_mip) capacitor c=50f
rfmp (x_mip x_bmp) resistor r=50k
xbmpp (x_bmp x_mip vbuf vbuf) sg13_lv_pmos w=6u l=0.13u
xbmpn (x_bmp x_mip 0 0) sg13_lv_nmos w=3u l=0.13u
xb2pp (ckp x_bmp vbuf vbuf) sg13_lv_pmos w=8.0u l=0.13u
xb2pn (ckp x_bmp 0 0) sg13_lv_nmos w=4.0u l=0.13u
ccn (tn x_bin) capacitor c=100f
rfn (x_bin x_bon) resistor r=50k
xb1np (x_bon x_bin vbuf vbuf) sg13_lv_pmos w=4u l=0.13u
xb1nn (x_bon x_bin 0 0) sg13_lv_nmos w=2u l=0.13u
ccmn (x_bon x_min) capacitor c=50f
rfmn (x_min x_bmn) resistor r=50k
xbmnp (x_bmn x_min vbuf vbuf) sg13_lv_pmos w=6u l=0.13u
xbmnn (x_bmn x_min 0 0) sg13_lv_nmos w=3u l=0.13u
xb2np (ckn x_bmn vbuf vbuf) sg13_lv_pmos w=8.0u l=0.13u
xb2nn (ckn x_bmn 0 0) sg13_lv_nmos w=4.0u l=0.13u
xbxpp (x_bon x_bop vbuf vbuf) sg13_lv_pmos w=1u l=0.13u
xbxpn (x_bon x_bop 0 0) sg13_lv_nmos w=0.5u l=0.13u
xbxnp (x_bop x_bon vbuf vbuf) sg13_lv_pmos w=1u l=0.13u
xbxnn (x_bop x_bon 0 0) sg13_lv_nmos w=0.5u l=0.13u
xbopp (ckn ckp vbuf vbuf) sg13_lv_pmos w=2u l=0.13u
xbopn (ckn ckp 0 0) sg13_lv_nmos w=1u l=0.13u
xbonp (ckp ckn vbuf vbuf) sg13_lv_pmos w=2u l=0.13u
xbonn (ckp ckn 0 0) sg13_lv_nmos w=1u l=0.13u
